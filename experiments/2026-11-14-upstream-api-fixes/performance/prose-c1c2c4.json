{
  "name": "official-main-x1112-c1-c2-c4-prose-daily",
  "version": 1,
  "description": "Daily-load prose-only check at c1, c2 and c4.",
  "steps": [
    {
      "id": "c1",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 1,
        "warmup": 10,
        "duration": 30,
        "batches": 3,
        "prompts": "experiments/2026-11-12-official-main-x1112/prose-prompts.jsonl",
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c2",
      "command": "run",
      "args": {
        "mode": "closed",
