        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c4",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 4,
        "warmup": 10,
        "duration": 30,
        "batches": 3,
        "prompts": "experiments/2026-11-12-official-main-x1112/prose-prompts.jsonl",
