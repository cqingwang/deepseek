# deepseek target（spark-ds41f，vLLM/TileLang/sparknet one-shot RoCE）的配方固定面。
#
# 来源：config/cluster.json @ 2026-10-30-spark-ds41f-1030，经上游
# `scripts/recipe.py:resolve(..., "tp4-ring")` 渲染后的 81 个固定环境键。
# 这里保留改造前的原始值；站点需要修改的值只在受管块覆盖，未变化的键不得
# 搬进 config.yaml。pinned-GID 模式（NCCL_IB_GID_INDEX=3）不生成
# SPARKNET_ROCE_SUBNETS。
#
# deploy.sh 经 program.py query-managed-env 生成 `# BEGIN/END deploy.sh deepseek`
# 受管块。模板裸赋值与受管块同名时由受管块覆盖，write-managed-env 会删除旧
# 裸赋值，避免同一变量出现两个有效值。
#
# 模板固定键中被 common.spark_nodes/common.ring 覆盖的只有：
# GLOO_SOCKET_IFNAME、TP_SOCKET_IFNAME、NCCL_SOCKET_IFNAME、
# NCCL_IB_SUBNET_PREFIX_LEN、NCCL_IB_GID_INDEX。
# launcher 另按 rank 注入上游 sparknet 渲染的 NCCL_IB_HCA、
# SPARKNET_ROCE_PEER_HCAS、SPARKNET_ROCE_TOPOLOGY 与 VLLM_HOST_IP。
# program.py 输出的 MODEL_DIR、IMAGE_ID 等宿主编排键不得进入容器环境。
#
# 站点运行参数：SPARKNET_ROCE_ALLGATHER_MAX_BYTES=8388608 来自
# experiments/2026-11-07-runtime-prefill-tuning；它只提高 one-shot all-gather
# 分片上限，不改变数值。其余固定键保持 pinned recipe 的原值。

# ---- cluster.json `environment`（基座环境）----
CUDA_CACHE_MAXSIZE=4294967296
CUDA_CACHE_PATH=/cache/spark-ds41f/jit/nv-compute
CUDA_DEVICE_MAX_CONNECTIONS=64
DO_NOT_TRACK=1
HF_HOME=/cache/huggingface
HF_HUB_OFFLINE=1
MALLOC_ARENA_MAX=2
MALLOC_MMAP_THRESHOLD_=1048576
MAX_JOBS=2
OMP_NUM_THREADS=8
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True,garbage_collection_threshold:0.6
SAFETENSORS_FAST_GPU=1
SPARKNET_ROCE_ALLREDUCE_CAPACITY_BYTES=2097152
SPARKNET_ROCE_ALLREDUCE_DISPATCH_MAX_BYTES=2097152
SPARKNET_ROCE_PROXY_CPU=big
SPARKNET_ROCE_TIMEOUT_MS=10000
SPARK_DS41F_DSPARK_DEAD_ROWS_TAU=0.2
SPARK_DS41F_DSPARK_MAIN_PROJ_TP=1
SPARK_DS41F_DSPARK_VOCAB_PARALLEL=1
TILELANG_CACHE_DIR=/cache/spark-ds41f/jit/tilelang
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
TRANSFORMERS_OFFLINE=1
TRITON_CACHE_DIR=/cache/spark-ds41f/jit/triton
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_CACHE_DIR=/cache/spark-ds41f/jit/vllm
VLLM_CACHE_ROOT=/cache/spark-ds41f/jit/vllm
VLLM_DISABLE_PYNCCL=0
VLLM_DS41_HEAD_DTYPE=float32
VLLM_DS41_PACKED_BF16_LM_HEAD=1
VLLM_ENABLE_PCIE_ALLREDUCE=0
VLLM_ENGINE_READY_TIMEOUT_S=3600
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=900
VLLM_L2_PREFETCH_GRID=2
VLLM_L2_PREFETCH_KERNELS=tilelang
VLLM_LATE_ADMISSION_LAYER=30
VLLM_MAX_IMAGE_PIXELS=16777216
VLLM_NO_USAGE_STATS=1
VLLM_PLUGINS=
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_USE_V2_MODEL_RUNNER=1
XDG_CACHE_HOME=/cache/spark-ds41f/jit

# ---- cluster.json `shapes.tp4-ring.environment`（NCCL/sparknet 面）----
NCCL_ALGO=Ring
NCCL_BUFFSIZE=4194304
NCCL_COLLNET_ENABLE=0
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=1
NCCL_CUMEM_HOST_ENABLE=0
NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=INIT
NCCL_GIN_ENABLE=0
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_DISABLE=0
NCCL_IB_MERGE_NICS=1
NCCL_IB_QPS_PER_CONNECTION=2
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_LL128_BUFFSIZE=262144
NCCL_MAX_NCHANNELS=8
NCCL_MIN_NCHANNELS=8
NCCL_MIN_TRAFFIC_PER_CHANNEL=512
NCCL_MNNVL_ENABLE=0
NCCL_NET=IB
NCCL_NET_PLUGIN=none
NCCL_NVLS_ENABLE=0
NCCL_P2P_DISABLE=1
NCCL_PAT_ENABLE=0
NCCL_PROTO=^LL128
NCCL_RMA_DISABLE=1
NCCL_RUNTIME_CONNECT=1
NCCL_SHM_DISABLE=1
NCCL_SWITCHLESS_BIDIRECTIONAL=2
NCCL_THREAD_THRESHOLDS="-2 -2 -2 1 1 1"
SPARK_DS41F_DISPLAY_CARVEOUT_WEIGHTS=0
SPARKNET_ROCE_ALLGATHER_MAX_BYTES=8388608

# ---- recipe.resolve 渲染的 GLP 双模型固定面 ----
WEIGHTLESS_STEER_PATH=/glp/vector.gguf
WEIGHTLESS_STEER_MODEL=deepseek-v4.1-flash-weightless

# BEGIN deploy.sh deepseek
TARGET_ENGINE_ID=deepseek
TARGET_CONTAINER_PREFIX=deepseek
RUNTIME_ASSETS=/opt/runtime_assets/deepseek
CACHE_DIR=/opt/runtime_assets/deepseek/cache
MODEL_DIR=/opt/models/deepseek-ai/DeepSeek-V4.1-Flash-1017
MODEL_CONTAINER_PATH=/models/DeepSeek-V4.1-Flash-1017
IMAGE=spark-ds41f:1030
IMAGE_ID=sha256:84a8b73d0993200044b5eceb0892342d34a787416b7ae91e4b38f42fffc63e41
API_HOST=0.0.0.0
PORT=8888
HEAD_MANAGEMENT_IP=192.168.2.180
HEAD_SSH_TARGET=chan@192.168.2.180
WORKER_MANAGEMENT_IPS='192.168.2.161 192.168.2.102 192.168.2.238'
WORKER_SSH_TARGETS='chan@192.168.2.161 chan@192.168.2.102 chan@192.168.2.238'
WORKER_RANKS='1 2 3'
NNODES=4
TP_SIZE=4
GLOO_SOCKET_IFNAME=wlP9s9
TP_SOCKET_IFNAME=wlP9s9
NCCL_SOCKET_IFNAME=wlP9s9
NCCL_IB_GID_INDEX=3
NCCL_IB_HCA==roceP2p1s0f0,roceP2p1s0f1,rocep1s0f0,rocep1s0f1
SPARKNET_ROCE_PEER_HCAS_BY_RANK='{"0":{"1":["rocep1s0f0","roceP2p1s0f0"],"3":["rocep1s0f1","roceP2p1s0f1"]},"1":{"0":["rocep1s0f0","roceP2p1s0f0"],"2":["rocep1s0f1","roceP2p1s0f1"]},"2":{"1":["rocep1s0f1","roceP2p1s0f1"],"3":["rocep1s0f0","roceP2p1s0f0"]},"3":{"0":["rocep1s0f1","roceP2p1s0f1"],"2":["rocep1s0f0","roceP2p1s0f0"]}}'
NCCL_IB_SUBNET_PREFIX_LEN=30
API_KEY=deepseek
# END deploy.sh deepseek
