diff --git a/.env.deepseek.example b/.env.deepseek.example
index 17fd2440..4e557dee 100644
--- a/.env.deepseek.example
+++ b/.env.deepseek.example
@@ -16,11 +16,15 @@
 # launcher 另按 rank 注入上游 sparknet 渲染的 NCCL_IB_HCA、
 # SPARKNET_ROCE_PEER_HCAS、SPARKNET_ROCE_TOPOLOGY 与 VLLM_HOST_IP。
 # program.py 输出的 MODEL_DIR、IMAGE_ID 等宿主编排键不得进入容器环境。
+#
+# 站点运行参数来自两轮 prefill 实验：chunk/阈值、8 MiB one-shot all-gather、
+# 8 个 NCCL channels、CUDA connections=64 和 NCCL QPS=2。它们只改变调度与
+# 通信路径，不改变模型权重或算术；其余 pinned recipe 固定键保持原值。
 
 # ---- cluster.json `environment`（基座环境）----
 CUDA_CACHE_MAXSIZE=4294967296
 CUDA_CACHE_PATH=/cache/spark-ds41f/jit/nv-compute
-CUDA_DEVICE_MAX_CONNECTIONS=32
+CUDA_DEVICE_MAX_CONNECTIONS=64
 DO_NOT_TRACK=1
 GLOO_SOCKET_IFNAME=enP7s7
 HF_HOME=/cache/huggingface
@@ -76,13 +80,14 @@ NCCL_IB_ADDR_FAMILY=AF_INET
 NCCL_IB_DISABLE=0
 NCCL_IB_GID_INDEX=3
 NCCL_IB_MERGE_NICS=1
+NCCL_IB_QPS_PER_CONNECTION=2
 NCCL_IB_ROCE_VERSION_NUM=2
 NCCL_IB_SUBNET_AWARE_ROUTING=1
 NCCL_IB_SUBNET_PREFIX_LEN=24
 NCCL_IGNORE_CPU_AFFINITY=1
 NCCL_LL128_BUFFSIZE=262144
-NCCL_MAX_NCHANNELS=4
-NCCL_MIN_NCHANNELS=4
+NCCL_MAX_NCHANNELS=8
+NCCL_MIN_NCHANNELS=8
 NCCL_MIN_TRAFFIC_PER_CHANNEL=512
 NCCL_MNNVL_ENABLE=0
 NCCL_NET=IB
@@ -98,7 +103,7 @@ NCCL_SOCKET_IFNAME=enP7s7
 NCCL_SWITCHLESS_BIDIRECTIONAL=2
 NCCL_THREAD_THRESHOLDS="-2 -2 -2 1 1 1"
 SPARK_DS41F_DISPLAY_CARVEOUT_WEIGHTS=0
-SPARKNET_ROCE_ALLGATHER_MAX_BYTES=2097152
+SPARKNET_ROCE_ALLGATHER_MAX_BYTES=8388608
 
 # ---- recipe.resolve 渲染的 GLP 双模型固定面 ----
 WEIGHTLESS_STEER_PATH=/glp/vector.gguf
