{
  "name": "spark-ds41f-original-prose-c1-c2-c4-daily",
  "version": 1,
  "description": "Original-source abtest: daily-load prose-only c1/c2/c4; two runs are compared by mean.",
  "steps": [
    {
      "id": "c1",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 1,
        "warmup": 10,
        "duration": 30,
        "batches": 3,
        "prompts": "/opt/abtest-inputs/prose-prompts.jsonl",
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c2",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 2,
        "warmup": 10,
        "duration": 30,
        "batches": 3,
        "prompts": "/opt/abtest-inputs/prose-prompts.jsonl",
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    },
    {
      "id": "c4",
      "command": "run",
      "args": {
        "mode": "closed",
        "concurrency": 4,
        "warmup": 10,
        "duration": 30,
        "batches": 3,
        "prompts": "/opt/abtest-inputs/prose-prompts.jsonl",
        "extra_body": {
          "chat_template_kwargs": {
            "thinking": false
          }
        }
      }
    }
  ]
}
